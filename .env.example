PORT=3000
FIREBASE_DATABASE_URL=https://yapoodbr-delivery-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={...JSON DA SERVICE ACCOUNT BR...}
ALLOWED_ORIGINS=https://SEU-DOMINIO-BR.com
RATE_LIMIT_MAX=60

# URL HTTPS pública desta API no Render
MP_WEBHOOK_URL=https://api-mp-yapoodbr.onrender.com/webhook/mercadopago

# Chave secreta gerada em Mercado Pago > Webhooks
MP_WEBHOOK_SECRET=

# Opcional/legado. O checkout por loja usa o token em:
# restaurantes_privado/{lojaId}/mp_token
MP_TOKEN=

# --- OAuth Mercado Pago (lojista conecta a conta pelo ADM) ---
# Crie UMA aplicação da plataforma em mercadopago.com.br/developers e copie Client ID e Client Secret.
# Em "Redirect URL" da aplicação cadastre exatamente o valor de MP_OAUTH_REDIRECT_URI.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://api-mp-yapoodbr.onrender.com/oauth/mp/callback
# Site do front (para onde o lojista volta depois de autorizar). Ex.: https://yapoodbr.vercel.app
FRONTEND_URL=https://yapoodbr.vercel.app

# --- Código de entrega (V2.3) ---
# Segredo longo e aleatório (mín. 16 caracteres). Não troque depois de publicar: muda todos os códigos.
PIN_SECRET=
