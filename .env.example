FIREBASE_DATABASE_URL=https://yapoodbr-delivery-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", "...":"COLE_AQUI_SEU_JSON_REAL"}
# Endereço do app (https). Os avisos abrem telas dentro dele: status.html, admin-loja.html, entregador.html.
APP_URL=https://SEU-APP.vercel.app
# Origens que podem chamar a API, separadas por vírgula (sem barra no fim). Recomendado preencher.
ALLOWED_ORIGINS=https://SEU-APP.vercel.app
# Trava de segurança: a chave de serviço precisa ser deste projeto.
EXPECTED_PROJECT_ID=yapoodbr-delivery

# V7.3 — e-mail da decisão do cadastro de lojista (opcional; sem isso só o push sai)
RESEND_API_KEY=
EMAIL_FROM=YaPOOD <nao-responda@seudominio.com.br>

# V7.4: a mesma chave no serviço da API (api-mp-yapoodbr). Mínimo 16 caracteres. Não coloque no site nem no GitHub.
NOTPUSH_CHAVE_INTERNA=

# V7.6 — agendador das ofertas automáticas (cron-job.org chama POST /cron/ofertas com o cabeçalho X-Push-Cron-Chave).
# Chave NOVA, só deste serviço (não reaproveite outras). Mínimo 16 caracteres. Fica só aqui no Render e no cron-job.org.
PUSH_CRON_CHAVE=
